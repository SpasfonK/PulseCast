{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": "ask",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "execute_git status": "allow",
    "execute_git diff": "allow",
    "execute_./gradlew assembleDebug": "ask",
    "execute_git push": "deny",
    "execute_rm -rf*": "deny",
    "execute_sudo*": "deny"
  },
  "compaction": {
    "auto": true,
    "threshold_percent": 70,
    "prune": true
  },
  "provider": {
    "openrouter": {
      "options": {
        "provider": {
          "sort": "price",
          "data_collection": "deny",
          "zdr": true
        }
      }
    }
  }
}